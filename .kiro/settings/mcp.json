{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp",
      "disabled": false,
      "autoApprove": [
        "list_projects",
        "list_tables",
        "apply_migration",
        "get_project_url",
        "get_publishable_keys",
        "generate_typescript_types",
        "execute_sql",
        "get_advisors",
        "get_project",
        "restore_project"
      ],
      "description": "Supabase MCP Server - Manage your Supabase projects, databases, and Edge Functions"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "autoApprove": [
        "browser_navigate",
        "browser_click",
        "browser_snapshot",
        "browser_fill_form",
        "browser_select_option",
        "browser_close",
        "browser_handle_dialog",
        "browser_take_screenshot",
        "browser_run_code"
      ]
    }
  }
}